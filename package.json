{
  "name": "svdex-discourse",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "SVDEX native Discourse plugin, theme and local setup",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "doctor": "node scripts/doctor.js",
    "setup": "bash scripts/discourse-local.sh setup",
    "start": "bash scripts/discourse-local.sh start",
    "stop": "bash scripts/discourse-local.sh stop",
    "status": "bash scripts/discourse-local.sh status",
    "test": "node --test test/*.test.js",
    "check": "node scripts/check.js && npm test",
    "check:discourse": "bash scripts/check-discourse-local.sh",
    "sync:themes": "bash scripts/discourse-local.sh theme",
    "sync:styles": "bash scripts/discourse-local.sh appearance",
    "sync:plugin": "bash scripts/discourse-local.sh listings",
    "build:styles": "node scripts/build-styles.js",
    "package:source": "node scripts/package-source.js",
    "check:browser": "playwright test"
  },
  "license": "GPL-2.0-or-later",
  "devDependencies": {
    "@playwright/test": "1.65.1"
  }
}
