{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Description": "Isolated SVDEX staging host: own encrypted storage, private artifacts, no production access or mail credentials.",
  "Parameters": {
    "VpcId": {
      "Type": "AWS::EC2::VPC::Id"
    },
    "SubnetId": {
      "Type": "AWS::EC2::Subnet::Id"
    },
    "ImageId": {
      "Type": "AWS::EC2::Image::Id"
    }
  },
  "Resources": {
    "BackupBucket": {
      "Type": "AWS::S3::Bucket",
      "Properties": {
        "BucketName": {
          "Fn::Sub": "svdex-staging-${AWS::AccountId}-${AWS::Region}"
        },
        "BucketEncryption": {
          "ServerSideEncryptionConfiguration": [
            {
              "ServerSideEncryptionByDefault": {
                "SSEAlgorithm": "AES256"
              }
            }
          ]
        },
        "PublicAccessBlockConfiguration": {
          "BlockPublicAcls": true,
          "BlockPublicPolicy": true,
          "IgnorePublicAcls": true,
          "RestrictPublicBuckets": true
        },
        "VersioningConfiguration": {
          "Status": "Enabled"
        },
        "LifecycleConfiguration": {
          "Rules": [
            {
              "Id": "DailyBackupRetention",
              "Status": "Enabled",
              "Prefix": "backups/",
              "ExpirationInDays": 7,
              "NoncurrentVersionExpiration": {
                "NoncurrentDays": 7
              }
            }
          ]
        },
        "Tags": [
          {
            "Key": "App",
            "Value": "SVDEX"
          },
          {
            "Key": "Purpose",
            "Value": "private-release-and-backup-storage"
          }
        ]
      }
    },
    "BucketPolicy": {
      "Type": "AWS::S3::BucketPolicy",
      "Properties": {
        "Bucket": {
          "Ref": "BackupBucket"
        },
        "PolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Deny",
              "Principal": "*",
              "Action": "s3:*",
              "Resource": [
                {
                  "Fn::GetAtt": [
                    "BackupBucket",
                    "Arn"
                  ]
                },
                {
                  "Fn::Sub": "${BackupBucket.Arn}/*"
                }
              ],
              "Condition": {
                "Bool": {
                  "aws:SecureTransport": "false"
                }
              }
            }
          ]
        }
      }
    },
    "HostRole": {
      "Type": "AWS::IAM::Role",
      "Properties": {
        "AssumeRolePolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Principal": {
                "Service": "ec2.amazonaws.com"
              },
              "Action": "sts:AssumeRole"
            }
          ]
        },
        "ManagedPolicyArns": [
          {
            "Fn::Sub": "arn:${AWS::Partition}:iam::aws:policy/AmazonSSMManagedInstanceCore"
          }
        ],
        "Policies": [
          {
            "PolicyName": "SvdexStorage",
            "PolicyDocument": {
              "Version": "2012-10-17",
              "Statement": [
                {
                  "Effect": "Allow",
                  "Action": "s3:GetObject",
                  "Resource": {
                    "Fn::Sub": "${BackupBucket.Arn}/releases/github/*/release.tar.gz"
                  }
                },
                {
                  "Effect": "Allow",
                  "Action": "s3:PutObject",
                  "Resource": [
                    {
                      "Fn::Sub": "${BackupBucket.Arn}/deployments/github/*.json"
                    },
                    {
                      "Fn::Sub": "${BackupBucket.Arn}/deployments/verified.json"
                    }
                  ],
                  "Condition": {
                    "StringEquals": {
                      "s3:x-amz-server-side-encryption": "AES256"
                    }
                  }
                },
                {
                  "Effect": "Allow",
                  "Action": "ssm:GetParameter",
                  "Resource": {
                    "Fn::Sub": "arn:${AWS::Partition}:ssm:${AWS::Region}:${AWS::AccountId}:parameter/svdex/staging/admin-password"
                  }
                }
              ]
            }
          }
        ]
      }
    },
    "HostProfile": {
      "Type": "AWS::IAM::InstanceProfile",
      "Properties": {
        "Roles": [
          {
            "Ref": "HostRole"
          }
        ]
      }
    },
    "WebSecurityGroup": {
      "Type": "AWS::EC2::SecurityGroup",
      "Properties": {
        "GroupDescription": "SVDEX HTTPS and HTTP; administration through SSM only",
        "VpcId": {
          "Ref": "VpcId"
        },
        "SecurityGroupIngress": [
          {
            "IpProtocol": "tcp",
            "FromPort": 80,
            "ToPort": 80,
            "CidrIp": "0.0.0.0/0"
          },
          {
            "IpProtocol": "tcp",
            "FromPort": 443,
            "ToPort": 443,
            "CidrIp": "0.0.0.0/0"
          }
        ],
        "Tags": [
          {
            "Key": "Name",
            "Value": "svdex-staging-web"
          }
        ]
      }
    },
    "Host": {
      "Type": "AWS::EC2::Instance",
      "Properties": {
        "ImageId": {
          "Ref": "ImageId"
        },
        "InstanceType": "t3a.medium",
        "IamInstanceProfile": {
          "Ref": "HostProfile"
        },
        "DisableApiTermination": false,
        "MetadataOptions": {
          "HttpTokens": "required",
          "HttpPutResponseHopLimit": 1
        },
        "NetworkInterfaces": [
          {
            "AssociatePublicIpAddress": true,
            "DeleteOnTermination": true,
            "DeviceIndex": "0",
            "GroupSet": [
              {
                "Ref": "WebSecurityGroup"
              }
            ],
            "SubnetId": {
              "Ref": "SubnetId"
            }
          }
        ],
        "BlockDeviceMappings": [
          {
            "DeviceName": "/dev/sda1",
            "Ebs": {
              "Encrypted": true,
              "VolumeType": "gp3",
              "VolumeSize": 40,
              "DeleteOnTermination": true
            }
          }
        ],
        "Tags": [
          {
            "Key": "Name",
            "Value": "svdex-staging"
          },
          {
            "Key": "App",
            "Value": "SVDEX"
          }
        ],
        "UserData": {
          "Fn::Base64": {
            "Fn::Sub": "#!/bin/bash\nset -eu\nexec > >(tee -a /var/log/svdex-bootstrap.log) 2>&1\nexport DEBIAN_FRONTEND=noninteractive\napt-get update\napt-get install -y docker.io git curl unzip jq python3\nif ! swapon --show | grep -q /swapfile; then\n  fallocate -l 4G /swapfile\n  chmod 600 /swapfile\n  mkswap /swapfile\n  swapon /swapfile\n  echo '/swapfile none swap sw 0 0' >> /etc/fstab\nfi\nprintf 'vm.swappiness=10\\n' > /etc/sysctl.d/90-svdex.conf\nsysctl --system\nmkdir -p /etc/docker\nprintf '%s\\n' '{\"log-driver\":\"json-file\",\"log-opts\":{\"max-size\":\"10m\",\"max-file\":\"3\"}}' > /etc/docker/daemon.json\nsystemctl enable --now docker\nsystemctl restart docker\ncurl --fail --location --retry 3 https://awscli.amazonaws.com/awscli-exe-linux-x86_64.zip -o /tmp/awscliv2.zip\nunzip -q /tmp/awscliv2.zip -d /tmp/awscli-install\n/tmp/awscli-install/aws/install\nrm -rf /tmp/awscli-install /tmp/awscliv2.zip\nif [ ! -d /var/discourse/.git ]; then git clone https://github.com/discourse/discourse_docker.git /var/discourse; fi\ngit -C /var/discourse checkout --detach 1309ec425ab697996a33b931e309df95c1fbd981\nmkdir -p /var/lib/svdex\nchmod 700 /var/lib/svdex\nprintf 'AWS_DEFAULT_REGION=${AWS::Region}\\n' > /etc/svdex-aws.env\nchmod 600 /etc/svdex-aws.env\ndocker info >/dev/null\ndate -u > /var/lib/svdex/bootstrap-ready\n"
          }
        }
      }
    },
    "PublicAddress": {
      "Type": "AWS::EC2::EIP",
      "Properties": {
        "Domain": "vpc",
        "Tags": [
          {
            "Key": "Name",
            "Value": "svdex-staging"
          },
          {
            "Key": "App",
            "Value": "SVDEX"
          }
        ]
      }
    },
    "AddressAssociation": {
      "Type": "AWS::EC2::EIPAssociation",
      "Properties": {
        "AllocationId": {
          "Fn::GetAtt": [
            "PublicAddress",
            "AllocationId"
          ]
        },
        "InstanceId": {
          "Ref": "Host"
        }
      }
    },
    "StageDocument": {
      "Type": "AWS::SSM::Document",
      "Properties": {
        "Name": "SVDEX-DeployStagingRelease",
        "DocumentType": "Command",
        "UpdateMethod": "NewVersion",
        "Content": {
          "schemaVersion": "2.2",
          "parameters": {
            "ReleaseSha": {
              "type": "String",
              "allowedPattern": "^[0-9a-f]{40}$"
            },
            "ArchiveSha256": {
              "type": "String",
              "allowedPattern": "^[0-9a-f]{64}$"
            },
            "RunId": {
              "type": "String",
              "allowedPattern": "^[0-9]{1,20}-[0-9]{1,5}$"
            }
          },
          "mainSteps": [
            {
              "action": "aws:runShellScript",
              "name": "deployStaging",
              "inputs": {
                "timeoutSeconds": "3600",
                "runCommand": [
                  "bash /usr/local/sbin/svdex-deploy-staging-release '{{ ReleaseSha }}' '{{ ArchiveSha256 }}' '{{ RunId }}'"
                ]
              }
            }
          ]
        }
      }
    },
    "StageDeployRole": {
      "Type": "AWS::IAM::Role",
      "Properties": {
        "RoleName": "SVDEX-GitHubStagingDeploy",
        "MaxSessionDuration": 3600,
        "AssumeRolePolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Principal": {
                "Federated": {
                  "Fn::Sub": "arn:${AWS::Partition}:iam::${AWS::AccountId}:oidc-provider/token.actions.githubusercontent.com"
                }
              },
              "Action": "sts:AssumeRoleWithWebIdentity",
              "Condition": {
                "StringEquals": {
                  "token.actions.githubusercontent.com:aud": "sts.amazonaws.com",
                  "token.actions.githubusercontent.com:sub": "repo:ahe6@63238928/svdex@1457761280:environment:staging"
                }
              }
            }
          ]
        },
        "Policies": [
          {
            "PolicyName": "StagingDeliveryOnly",
            "PolicyDocument": {
              "Version": "2012-10-17",
              "Statement": [
                {
                  "Effect": "Allow",
                  "Action": "s3:PutObject",
                  "Resource": {
                    "Fn::Sub": "${BackupBucket.Arn}/releases/github/*/release.tar.gz"
                  },
                  "Condition": {
                    "StringEquals": {
                      "s3:x-amz-server-side-encryption": "AES256"
                    }
                  }
                },
                {
                  "Effect": "Allow",
                  "Action": "s3:GetObject",
                  "Resource": {
                    "Fn::Sub": "${BackupBucket.Arn}/deployments/github/*.json"
                  }
                },
                {
                  "Effect": "Allow",
                  "Action": "ssm:SendCommand",
                  "Resource": [
                    {
                      "Fn::Sub": "arn:${AWS::Partition}:ssm:${AWS::Region}:${AWS::AccountId}:document/${StageDocument}"
                    },
                    {
                      "Fn::Sub": "arn:${AWS::Partition}:ec2:${AWS::Region}:${AWS::AccountId}:instance/${Host}"
                    }
                  ]
                }
              ]
            }
          }
        ]
      }
    }
  },
  "Outputs": {
    "InstanceId": {
      "Value": {
        "Ref": "Host"
      }
    },
    "PublicIPv4": {
      "Value": {
        "Ref": "PublicAddress"
      }
    },
    "BackupBucket": {
      "Value": {
        "Ref": "BackupBucket"
      }
    },
    "DeployRoleArn": {
      "Value": {
        "Fn::GetAtt": [
          "StageDeployRole",
          "Arn"
        ]
      }
    }
  }
}
